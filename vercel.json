{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/tickets", "destination": "/api/tickets.js" },
    { "source": "/api/organisateur", "destination": "/api/organisateur.js" }
  ]
}

{
  "headers": [
    {
      "source": "/(guide|conditions|contact|histoire|notre-histoire)(.html)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}